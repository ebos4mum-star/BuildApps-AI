# Copy to .env.local and fill in. NEVER commit real values.
# Local Supabase values come from `supabase start` output (local dev only).

# --- Public (safe for clients) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (never expose to clients, never prefix with NEXT_PUBLIC_/EXPO_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
# GitHub App (read-only: Contents, Metadata, Checks). See docs/GITHUB_APP.md
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM private key; newlines may be written as \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# >= 32 random characters; signs the install-flow `state`
GITHUB_STATE_SECRET=
# Public origin of the web app (used for the post-install redirect)
APP_URL=http://localhost:3000
# Later phases: AI provider, billing
ANTHROPIC_API_KEY=
AI_DAILY_TOKEN_LIMIT_PER_USER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
